# Multi-stage build for Spring Boot backend
FROM gradle:8.5-jdk17-alpine AS build

# Set working directory
WORKDIR /app

# Copy gradle files
COPY build.gradle settings.gradle ./

# Copy source code
COPY src/ src/

# Build the application using gradle directly
RUN gradle bootJar --no-daemon

# Runtime stage - Use Debian instead of Alpine for glibc compatibility
# Alpine uses musl libc which is incompatible with gRPC native libraries
FROM eclipse-temurin:17-jre-jammy

# Install required system libraries for gRPC native support
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN groupadd -g 1001 appuser && useradd -u 1001 -g appuser appuser

# Set working directory
WORKDIR /app

# Copy the built jar from build stage
COPY --from=build /app/build/libs/*.jar app.jar

# Create app directory and set ownership
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8080

# Run the application
ENTRYPOINT ["java", "-Dspring.profiles.active=cloud", "-Dserver.port=${PORT:-8080}", "-Dserver.address=0.0.0.0", "-jar", "app.jar"]
